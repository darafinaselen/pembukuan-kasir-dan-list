# contoh .env untuk docker-compose
# Salin file ini menjadi `.env` dan sesuaikan nilainya sebelum menjalankan `docker-compose up`.

# Postgres
POSTGRES_USER=app_user
POSTGRES_PASSWORD=supersecretpassword
POSTGRES_DB=app_db
# Port yang akan dipetakan ke host (opsional). Default di compose: 5432
POSTGRES_PORT=5432

# Prisma / DATABASE_URL (contoh, gunakan nilai di atas atau sesuaikan)
# Format untuk Prisma: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://app_user:supersecretpassword@localhost:5432/app_db?schema=public

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadminpassword
MINIO_BUCKET=my-bucket
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Opsional: custom host/ports
APP_HOST=localhost
APP_PORT=3000

# ============================================
# SECURITY & AUTHENTICATION
# ============================================

# JWT Secret (Generate with: openssl rand -base64 32)
# CRITICAL: Change this in production!
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production-use-long-random-string"

# Application Environment
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Session Configuration
SESSION_EXPIRY_DAYS=7

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# Password Policy
MIN_PASSWORD_LENGTH=8
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_DURATION_MINUTES=30

# Audit Logging
ENABLE_AUDIT_LOGGING=true
AUDIT_LOG_RETENTION_DAYS=365

# Email Configuration (for password reset & notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM="noreply@pembukuan.com"
APP_NAME="Pembukuan Kasir"

# Data Encryption (optional)
ENCRYPTION_KEY="your-encryption-key-32-characters-minimum-length"

# CORS Configuration
ALLOWED_ORIGINS="http://localhost:3000,https://yourdomain.com"

# Default Admin User (for initial setup)
DEFAULT_ADMIN_USERNAME="admin"
DEFAULT_ADMIN_EMAIL="admin@pembukuan.com"
DEFAULT_ADMIN_PASSWORD="ChangeThisPassword123!"
