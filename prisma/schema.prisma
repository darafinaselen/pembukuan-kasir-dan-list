// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PackageType {
  CAR_RENTAL
  TOUR_PACKAGE
  FULL_DAY_TRIP
}

enum ArmadaStatus {
  READY
  BOOKED
  ON_TRIP
  MAINTENANCE
}

enum DriverStatus {
  READY
  ON_TRIP
  OFF_DUTY
}

enum PaymentStatus {
  UNPAID
  DOWN_PAYMENT
  PAID
}

enum UserRole {
  ADMIN
  MANAGER
  OPERATOR
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  VIEW
  EXPORT
}

// Modul 2.5: Manajemen Paket Jasa
model ServicePackage {
  id                String      @id @default(uuid())
  name              String
  type              PackageType
  description       String?
  includes          String[]
  excludes          String[]
  isCustomizable    Boolean     @default(false)
  customizableItems String[]

  // Fields for CAR_RENTAL type
  price         Int?
  durationHours Int?
  overtimeRate  Int?

  // Fields for TOUR_PACKAGE type
  durationDays   Int?
  durationNights Int?
  hotelTiers     HotelTier[]
  itineraries    ItineraryDay[]

  // Relasi: Satu paket bisa digunakan di banyak transaksi
  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("service_packages")
}

model HotelTier {
  id               String            @id @default(uuid())
  starRating       Int
  pricePerPax      Int
  servicePackageId String
  servicePackage   ServicePackage    @relation(fields: [servicePackageId], references: [id], onDelete: Cascade)
  hotels           Hotel[]
  priceRanges      HotelPriceRange[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("hotel_tiers")
}

model Hotel {
  id          String    @id @default(uuid())
  name        String
  hotelTierId String
  hotelTier   HotelTier @relation(fields: [hotelTierId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("hotels")
}

model HotelPriceRange {
  id          String    @id @default(uuid())
  minPax      Int
  maxPax      Int
  price       Int
  hotelTierId String
  hotelTier   HotelTier @relation(fields: [hotelTierId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("hotel_price_ranges")
}

model ItineraryDay {
  id               String         @id @default(uuid())
  day              Int
  title            String
  description      String?
  servicePackageId String
  servicePackage   ServicePackage @relation(fields: [servicePackageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("itinerary_days")
}

// Modul 3: Manajemen Armada
model Armada {
  id            String       @id @default(uuid())
  license_plate String       @unique
  brand         String
  model         String
  status        ArmadaStatus @default(READY)

  // Relasi: Satu armada bisa ada di banyak transaksi
  transactions Transaction[]
  // Relasi: Satu armada bisa memiliki banyak catatan pengeluaran (servis, dll)
  expenses     Expense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("armadas")
}

// Modul 4: Manajemen Sopir
model Driver {
  id           String       @id @default(uuid())
  driver_name  String
  nik          String?
  phone_number String
  address      String?
  status       DriverStatus @default(READY)

  // Relasi: Satu sopir bisa ditugaskan di banyak transaksi
  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("drivers")
}

// 4. Model Database (Data Transaksional - Milik Developer A)

// Modul 5: Manajemen Pengeluaran Operasional
model Expense {
  id          String   @id @default(uuid())
  date        DateTime @db.Date
  category    String // Misal: "Servis", "Biaya Kantor", "Gaji Admin"
  description String
  amount      Int

  // Relasi: Pengeluaran ini (opsional) terkait dengan armada mana
  armadaId String?
  armada   Armada? @relation(fields: [armadaId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("expenses")
}

// Modul 2: Manajemen Transaksi
model Transaction {
  id                String   @id @default(uuid())
  invoice_code      String   @unique
  customer_name     String
  customer_phone    String
  booking_date      DateTime @db.Date
  checkout_datetime DateTime // Waktu mobil keluar
  checkin_datetime  DateTime // Waktu mobil kembali

  // Data Keuangan
  all_in_rate            Int // Tarif sewa
  overtime_rate_per_hour Int
  fuel_cost              Int // Biaya BBM (dicatat per transaksi)
  driver_fee             Int // Biaya Gaji Sopir (dicatat per transaksi)
  payment_status         PaymentStatus @default(UNPAID)

  // Data Tambahan untuk Paket Wisata
  hotel_name String? // Nama hotel yang dipilih (opsional, untuk TOUR_PACKAGE)
  pax_count  Int? // Jumlah penumpang/pax (opsional, untuk TOUR_PACKAGE)

  // --- Relasi (Foreign Keys) ---

  // Relasi: Transaksi ini (opsional) menggunakan paket apa
  packageId String?
  package   ServicePackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  // Relasi: Transaksi ini (wajib) menggunakan armada apa
  // onDelete: Restrict -> Mencegah armada dihapus jika masih punya riwayat transaksi
  armadaId String
  armada   Armada @relation(fields: [armadaId], references: [id], onDelete: Restrict)

  // Relasi: Transaksi ini (wajib) menggunakan sopir siapa
  // onDelete: Restrict -> Mencegah sopir dihapus jika masih punya riwayat transaksi
  driverId String
  driver   Driver @relation(fields: [driverId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("transactions")
}

// Modul 6: Authentication & Authorization
model User {
  id          String    @id @default(uuid())
  email       String    @unique
  username    String    @unique
  password    String // Hashed with bcrypt
  name        String
  role        UserRole  @default(OPERATOR)
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  lastLoginIp String?

  // Password reset
  resetToken       String?   @unique
  resetTokenExpiry DateTime?

  // Account security
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Relasi
  sessions  Session[]
  auditLogs AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

// Modul 7: Audit Logging untuk Compliance
model AuditLog {
  id          String      @id @default(uuid())
  userId      String?
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      AuditAction
  resource    String // e.g., "Transaction", "Armada", "User"
  resourceId  String? // ID of the affected resource
  description String // Human-readable description
  metadata    Json? // Additional data (before/after values, etc.)
  ipAddress   String?
  userAgent   String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
  @@map("audit_logs")
}
